{
  "name": "tonecraft",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run schema:generate && npm run build:worklet && astro dev",
    "build": "npm run schema:generate && npm run build:worklet && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "schema:generate": "tsx schema/generate.ts",
    "schema:check": "tsx schema/generate.ts --check",
    "build:wasm": "bash dsp/build.sh",
    "build:worklet": "tsx engine/build-worklet.ts",
    "check:flags": "bash scripts/check-build-flags.sh",
    "test:wasm": "tsx engine/wasm.test.ts",
    "test:input": "tsx engine/input.test.ts",
    "test": "npm run check:invariants && npm run test:input && npm run test:wasm",
    "check:invariants": "bash scripts/check-build-flags.sh && bash scripts/check-stage-isolation.sh",
    "weights:placeholder": "tsx scripts/make-placeholder-weights.ts",
    "bench": "tsx engine/bench.ts",
    "deps": "bash scripts/fetch-deps.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.2.10",
    "nanostores": "^1.5.2",
    "svelte": "^5.57.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "description": "Guitar amp and effects in a browser tab. No install, no plugin, no account, no server.",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
