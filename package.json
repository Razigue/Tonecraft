{
  "name": "tonecraft",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "vendor": "node scripts/vendor-nam.mjs",
    "model:header": "tsx scripts/generate-model-header.ts",
    "model:build": "bash dsp/build.sh",
    "model:convert": "tsx scripts/nam-to-tcnm.ts",
    "model:verify": "tsx scripts/verify-model.ts",
    "bench:model": "tsx scripts/bench-model.ts",
    "measure:load": "node scripts/measure-load.mjs",
    "calibrate": "tsx scripts/calibrate-models.ts",
    "measure": "tsx scripts/measure-aliasing.ts",
    "check": "tsx scripts/check-schema.ts",
    "test": "npm run check && npm run test:input && npm run test:diagnosis && npm run model:verify",
    "test:input": "tsx engine/input.test.ts",
    "test:diagnosis": "tsx engine/diagnosis.test.ts",
    "test:browser": "node scripts/browser-test.mjs",
    "verify": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.2.10",
    "nanostores": "^1.5.2",
    "svelte": "^5.57.0"
  },
  "description": "Guitar amp and effects in a browser tab. No install, no plugin, no account, no server.",
  "private": true,
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  }
}
