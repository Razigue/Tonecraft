# Dependencies
node_modules/

# Astro / Vite build output
dist/
.astro/
.vercel/
.netlify/

# AD-15: no build output is ever committed. A .wasm and the audio rendered
# from it must not be able to drift apart, and a binary in git history is
# there forever — against the 1 GB repository limit.
build/
*.o
*.bc
*.wasm
*.wasm.map

# Build-time renders: preset audio and its per-stage RMS envelope. Both are a
# pure function of the .wasm plus the DI loop in assets/, so CI regenerates
# them. Source assets in assets/ ARE committed.
public/presets/
site/**/*.generated.json

# Generated from schema/params.ts — never edited by hand, never committed
dsp/params.generated.h

# Astro generated types
.astro/

# npm logs
npm-debug.log*

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code — machine-local permissions, not shared
.claude/settings.local.json

# BMAD — personal install answers (see _bmad/custom/.gitignore)
*.user.toml
