# Dependencies
node_modules/

# Astro / Vite build output
dist/
.astro/
.vercel/
.netlify/

# AD-15: no build output is ever committed. A binary in git history is there
# forever, against the 1 GB repository limit.
build/
*.wasm
*.wasm.map

# Exception: the amp model. It is our build output, and it is committed anyway,
# because the alternative is emsdk in CI and on GitHub Pages for an 8 kB
# artifact that changes only when dsp/ does. Rebuild with `npm run model:build`;
# `npm run model:verify` fails if what is committed stops agreeing with NAM.
!public/nam/wavenet.wasm

# Generated from schema/params.ts by scripts/generate-model-header.ts, which
# dsp/build.sh runs first. The schema is the source of truth; this is a
# projection of it and is never edited or committed.
dsp/model/params.generated.h

# Build-time renders: preset audio and its per-stage RMS envelope. Both are a
# pure function of the .wasm plus the DI loop in assets/, so CI regenerates
# them. Source assets in assets/ ARE committed.
public/presets/
site/**/*.generated.json

# Astro generated types
.astro/

# npm logs
npm-debug.log*

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code — machine-local permissions, not shared
.claude/settings.local.json

# BMAD — personal install answers (see _bmad/custom/.gitignore)
*.user.toml

# Local Emscripten install (~1.7 GB). `dsp/build.sh` uses it, and only when
# dsp/ changes: the .wasm it produces is committed, so a clean checkout builds,
# tests and deploys without it.
.toolchain/

# The proof of concept this repository was ported from. A local input, kept out
# of history like the reference audio below.
tonecraft-poc.zip

# Reference audio used to tune by measurement: DI takes and the output of a
# commercial plugin on the same guitar. Not ours to redistribute, tens of
# megabytes, and audio in git history is there forever (AD-15). Kept locally.
sample_guitar/
