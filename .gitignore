# Dependencies
node_modules/

# Astro / Vite build output
dist/
.astro/
.vercel/
.netlify/

# AD-15: no build output is ever committed. A binary in git history is there
# forever, against the 1 GB repository limit.
build/
*.wasm
*.wasm.map

# Exception: the NAM engine. scripts/build-nam.mjs compiles it from pinned
# sources with SIMD, and it is committed so a clean checkout is deployable
# without a C++ toolchain and CI needs no network access beyond npm. Rebuild
# with `npm run build:nam`; the flags and what each was measured to be worth
# are in the script.
!public/nam/nam.wasm

# The NAM core sources the engine is built from, cloned at a pinned tag by
# scripts/build-nam.mjs. Not ours; re-fetched on demand. And the build's
# scratch directory.
.nam-src/
.nam-build-*/

# Build-time renders: preset audio and its per-stage RMS envelope. Both are a
# pure function of the .wasm plus the DI loop in assets/, so CI regenerates
# them. Source assets in assets/ ARE committed.
public/presets/
site/**/*.generated.json

# Astro generated types
.astro/

# npm logs
npm-debug.log*

# Env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.swp

# Claude Code — machine-local permissions, not shared
.claude/settings.local.json

# BMAD — personal install answers (see _bmad/custom/.gitignore)
*.user.toml

# Local Emscripten SDK (~2 GB), used only by scripts/build-nam.mjs. The
# committed engine means nobody needs it to run, test or deploy the site.
.toolchain/

# The proof of concept this repository was ported from. A local input, kept out
# of history like the reference audio below.
tonecraft-poc.zip

# Reference audio used to tune by measurement: DI takes and the output of a
# commercial plugin on the same guitar. Not ours to redistribute, tens of
# megabytes, and audio in git history is there forever (AD-15). Kept locally.
sample_guitar/
