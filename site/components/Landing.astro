  /*
   * Motion, in CSS only: the page ships no script to animate itself (the
   * choice was GSAP or 0 kB, and 0 kB won). Scroll-driven animations run off
   * the main thread, on transform and opacity alone. A browser without them
   * (Firefox today) shows the page still, which is the same page.
   */
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 800ms var(--ease) both; }
    .hero-copy > :nth-child(2) { animation-delay: 60ms; }
