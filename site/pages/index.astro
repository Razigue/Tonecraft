---
// Story 1.1 only proves the pipeline: scaffold, build, deploy. There is no
// engine, no chain and no sound yet — those arrive in stories 1.3 and after.
const stories = [
  { id: '1.1', title: 'A deploy that is a pure function of the commit', done: true },
  { id: '1.2', title: 'One source of truth for every parameter', done: false },
  { id: '1.3', title: 'Audio survives a round trip through WASM', done: false },
  { id: '1.4', title: 'The guitar signal arrives intact', done: false },
  { id: '1.5', title: 'The same tone on a 44.1 kHz interface', done: false },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Tonecraft — build pipeline</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        padding: 4rem 1.5rem;
        font: 15px/1.55 system-ui, sans-serif;
        background: #E7E8E2;
        color: #16181B;
      }
      main { max-width: 40rem; margin: 0 auto; }
      h1 { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.5rem; }
      p { color: #767A78; margin: 0 0 2rem; max-width: 34rem; }
      ol { list-style: none; padding: 0; margin: 0; }
      li {
        display: flex; gap: 1rem; align-items: baseline;
        padding: 0.75rem 0; border-top: 1px solid rgba(22,24,27,0.12);
      }
      .id { font-family: ui-monospace, monospace; font-size: 13px; color: #767A78; min-width: 2.5rem; }
      .done { color: #16181B; }
      .todo { color: #767A78; }
      @media (prefers-color-scheme: dark) {
        body { background: #16181B; color: #E7E8E2; }
        li { border-top-color: rgba(231,232,226,0.14); }
        .done { color: #E7E8E2; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Tonecraft</h1>
      <p>
        Nothing here makes sound yet. This page exists to prove that a commit
        builds and deploys with no manual step. The design system arrives in
        epic 2; until then this page is deliberately plain and is not indexed.
      </p>
      <ol>
        {stories.map((s) => (
          <li>
            <span class="id">{s.id}</span>
            <span class={s.done ? 'done' : 'todo'}>{s.title}</span>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>
