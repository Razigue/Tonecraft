---
// The app is a single Svelte island on a single route (FR-21). client:only
// because it owns an AudioContext, which cannot exist during a static build.
//
// The page carries nothing of its own: the chain is the interface, and the page
// is the rig (DESIGN.md section 4).
import Rig from '../../app/Rig.svelte';

// Same reason the engine resolves its URLs against the base: GitHub Pages
// serves a project repository under /<repo>/, and an absolute path 404s there.
const base = import.meta.env.BASE_URL;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <!-- Not indexed while the chain is incomplete. -->
    <meta name="robots" content="noindex" />
    <title>Tonecraft</title>
    <style is:global>
      /* Light only. DESIGN.md section 2 puts dark mode in v1.1 and says why:
         doing it properly means re-deriving the whole system, and a
         half-inverted palette looks worse than none. */
      :root { color-scheme: light; }
      html, body { margin: 0; background: #e7e8e2; color: #16181b; }
      body { -webkit-font-smoothing: antialiased; }
    </style>
  </head>
  <body>
    <Rig client:only="svelte" />
  </body>
</html>
