---
// The rig is a single Svelte island on a single route (FR-21). client:only
// because it owns an AudioContext, which cannot exist during a static build.
import Rig from '../../app/Rig.svelte';

const stories = [
  { id: '1.1', title: 'A deploy that is a pure function of the commit', done: true },
  { id: '1.2', title: 'One source of truth for every parameter', done: true },
  { id: '1.3', title: 'Audio survives a round trip through WASM', done: true },
  { id: '1.4', title: 'The guitar signal arrives intact', done: true },
  { id: '1.5', title: 'The same tone on a 44.1 kHz interface', done: true },
  { id: '1.6', title: 'The first real tone — infrastructure only, no trained model', done: false },
  { id: '1.7', title: 'The tone stops sounding cheap', done: true },
  { id: '1.9', title: 'Silence between the notes', done: true },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex" />
    <title>Tonecraft — build pipeline</title>
    <style>
      :root { color-scheme: light dark; }
      body {
        margin: 0;
        padding: 4rem 1.5rem;
        font: 15px/1.55 system-ui, sans-serif;
        background: #E7E8E2;
        color: #16181B;
      }
      main { max-width: 40rem; margin: 0 auto; }
      h1 { font-size: 1.25rem; font-weight: 500; margin: 0 0 0.5rem; }
      p { color: #767A78; margin: 0 0 2rem; max-width: 34rem; }
      main { display: flex; flex-direction: column; gap: 2.5rem; }
      h2.section { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
                   color: #767A78; font-weight: 400; margin: 0 0 -0.5rem; }
      :global(:root) { --muted: #767A78; }
      ol { list-style: none; padding: 0; margin: 0; }
      li {
        display: flex; gap: 1rem; align-items: baseline;
        padding: 0.75rem 0; border-top: 1px solid rgba(22,24,27,0.12);
      }
      .id { font-family: ui-monospace, monospace; font-size: 13px; color: #767A78; min-width: 2.5rem; }
      .done { color: #16181B; }
      .todo { color: #767A78; }
      @media (prefers-color-scheme: dark) {
        body { background: #16181B; color: #E7E8E2; }
        li { border-top-color: rgba(231,232,226,0.14); }
        .done { color: #E7E8E2; }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Tonecraft</h1>
      <p>
        Plug in and press start: your signal crosses the real WebAssembly chain
        and comes back. There is no amp yet — the chain is a pass-through and its
        limiter. The design system arrives in epic 2, so this page is
        deliberately plain and is not indexed.
      </p>
      <Rig client:only="svelte" />

      <h2 class="section">Epic 1</h2>
      <ol>
        {stories.map((s) => (
          <li>
            <span class="id">{s.id}</span>
            <span class={s.done ? 'done' : 'todo'}>{s.title}</span>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>
